<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_inherit_ux" model="ir.ui.view">
        <field name="name">project.task.form.inherit.ux</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_mail_ux" string="Enviar por correo" type="object" class="btn-primary" data-hotkey="q"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_preview_task" type="object" class="oe_stat_button" icon="fa-globe">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Vista de Cliente</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
