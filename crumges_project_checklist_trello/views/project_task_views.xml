<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_checklist" model="ir.ui.view">
        <field name="name">project.task.form.checklist</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="%(crumges_project_checklist_trello.action_project_task_checklist_wizard)d" type="action" class="oe_stat_button" icon="fa-check-square-o" context="{'default_task_id': id}" invisible="not trello_checklist_summary">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Checklists</span>
                        <span class="o_stat_value">
                            <field name="trello_checklist_summary"/>
                        </span>
                    </div>
                </button>
                <button name="action_clean_duplicate_checklists" type="object" class="oe_stat_button" icon="fa-copy" string="Limpiar duplicados"/>
            </div>
            <!-- Sección de Checklists después de la descripción -->
            <xpath expr="//page[@name='description_page']" position="after">
                <page name="checklist_page" string="Checklists">
                    <field name="checklist_ids" context="{'default_task_id': id}">
                        <list string="Checklists" editable="bottom" delete="0" decoration-bf="1">
                            <control>
                                <button name="%(crumges_project_checklist_trello.action_project_task_checklist_wizard)d" type="action" string="Añadir Checklist" context="{'default_task_id': parent.id}" class="btn-link"/>
                                <button name="action_clean_duplicate_checklists" type="object" string="Limpiar duplicados" class="btn-link"/>
                            </control>
                            <field name="sequence" widget="handle"/>
                            <field name="name" string="Checklist"/>
                            <field name="section_progress" string="Progreso" readonly="1"/>
                            <button name="action_view_checklist" type="object" string="Ítems" class="btn-link"/>
                            <button name="action_delete_checklist" type="object" string="Eliminar" icon="fa-trash" confirm="¿Estás seguro de querer eliminar este Checklist? También se eliminarán permanentemente todos sus ítems."/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_project_task_checklist_form" model="ir.ui.view">
        <field name="name">project.task.checklist.form</field>
        <field name="model">project.task.checklist</field>
        <field name="arch" type="xml">
            <form string="Checklist">
                <group>
                    <field name="task_id" invisible="1"/>
                    <field name="name" string="Checklist"/>
                    <field name="section_progress" string="Progreso" readonly="1"/>
                </group>
                <group string="Ítems">
                    <field name="item_ids" context="{'default_checklist_id': id}">
                        <list string="Ítems" editable="bottom" delete="0">
                            <control>
                                <create string="Añadir ítem"/>
                            </control>
                            <field name="sequence" widget="handle"/>
                            <field name="is_checked" widget="boolean"/>
                            <field name="name" string="Ítem"/>
                            <button name="action_delete_item" type="object" string="Eliminar" icon="fa-trash" confirm="¿Estás seguro de querer eliminar este ítem?"/>
                        </list>
                    </field>
                </group>
            </form>
        </field>
    </record>

    <record id="view_task_kanban_checklist" model="ir.ui.view">
        <field name="name">project.task.kanban.checklist</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='priority']" position="after">
                <t t-if="record.trello_checklist_summary.raw_value">
                    <div class="me-2 d-flex align-items-center" title="Checklist Progress">
                        <i class="fa fa-check-square-o me-1" role="img" aria-label="Checklist" title="Checklist"/>
                        <field name="trello_checklist_summary"/>
                    </div>
                </t>
            </xpath>
        </field>
    </record>
</odoo>