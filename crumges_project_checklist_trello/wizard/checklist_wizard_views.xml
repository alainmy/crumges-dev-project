<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_checklist_wizard_form" model="ir.ui.view">
        <field name="name">project.task.checklist.wizard.form</field>
        <field name="model">project.task.checklist.wizard</field>
        <field name="arch" type="xml">
            <form string="Añadir checklist">
                <group>
                    <field name="name"/>
                    <field name="is_copy"/>
                    <field name="copy_from_id" options="{'no_create': True}" invisible="not is_copy"/>
                    <field name="task_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_create_checklist" type="object" string="Añadir" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_task_checklist_wizard" model="ir.actions.act_window">
        <field name="name">Añadir Checklist</field>
        <field name="res_model">project.task.checklist.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
