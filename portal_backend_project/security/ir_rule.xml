<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Regla para Tareas: Permite escribir (editar) SOLO en las tareas asignadas. 
             La lectura de proyectos y tareas se hereda de las reglas nativas del portal (proyectos compartidos) -->
        <record model="ir.rule" id="project_task_portal_backend_rule">
            <field name="name">project.task: portal backend: write own tasks</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[('user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('portal_backend_project.group_portal_backend_project_user'))]"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="perm_write" eval="True"/>
        </record>
    </data>

    <data noupdate="0">
        <!-- Regla para Proyectos: Permite visualizar SOLO los proyectos donde el usuario es seguidor o está asignado a una tarea -->
        <record model="ir.rule" id="project_project_portal_backend_rule">
            <field name="name">project.project: portal backend: read own projects</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">['|', ('message_partner_ids', 'in', [user.partner_id.id]), ('task_ids.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[Command.link(ref('portal_backend_project.group_portal_backend_project_user'))]"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="perm_write" eval="False"/>
        </record>
    </data>

    <data noupdate="1">
        <!-- Regla para res.partner: Permitir lectura global a usuarios del portal backend de proyectos 
             para evitar errores de permisos al intentar ver a otros usuarios asignados o clientes del proyecto -->
        <record model="ir.rule" id="res_partner_portal_backend_project_rule">
            <field name="name">res.partner: portal backend project: read all</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('portal_backend_project.group_portal_backend_project_user'))]"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="perm_write" eval="False"/>
        </record>
    </data>
</odoo>
