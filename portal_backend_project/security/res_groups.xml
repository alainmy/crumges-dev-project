<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="category_portal_backend_project">
        <field name="name">Portal Proyecto</field>
        <field name="parent_id" ref="portal_backend.category_portal_advanced"/>
    </record>

    <record id="group_portal_backend_project_user" model="res.groups">
        <field name="name">Usuario (Solo Tareas Asignadas)</field>
        <field name="comment">Permite a los usuarios del portal visualizar proyectos existentes y ejecutar (escribir notas, subir adjuntos) únicamente las tareas que tengan asignadas. No pueden crear tareas nuevas.</field>
        <field name="category_id" ref="category_portal_backend_project"/>
    </record>

    <record id="group_portal_backend_project_manager" model="res.groups">
        <field name="name">Administrador (Puede crear Tareas)</field>
        <field name="comment">Otorga el permiso elevado para poder crear nuevas tareas y subtareas en los proyectos visibles.</field>
        <field name="category_id" ref="category_portal_backend_project"/>
        <field name="implied_ids" eval="[(4, ref('group_portal_backend_project_user'))]"/>
    </record>
</odoo>
