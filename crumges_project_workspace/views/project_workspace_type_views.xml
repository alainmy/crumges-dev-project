<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_workspace_type_list" model="ir.ui.view">
        <field name="name">project.workspace.type.list</field>
        <field name="model">project.workspace.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de Espacio de Trabajo" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_project_workspace_type" model="ir.actions.act_window">
        <field name="name">Tipos de Espacio de Trabajo</field>
        <field name="res_model">project.workspace.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_project_workspace_type"
              name="Tipos de Espacio de Trabajo"
              parent="project.menu_project_config"
              action="action_project_workspace_type"
              sequence="6"/>
</odoo>
