<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_project_approval_settings" model="ir.ui.view">
        <field name="name">project.project.approval.settings</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='settings']" position="inside">
                <group string="Approval Requirement Approvals">
                    <field name="use_approval_requirements"/>
                    <group invisible="not use_approval_requirements">
                        <field name="approval_default_content_type" widget="radio" options="{'horizontal': true}"/>
                        <field name="approval_default_note" placeholder="e.g. Please review the following proofs carefully. Once approved..."/>
                        <field name="approval_conformity_text" placeholder="e.g. I declare under oath that I have reviewed all the attached proofs..."/>
                        <field name="approval_force_login"/>
                    </group>
                    <group invisible="not use_approval_requirements" string="Stage &amp; State Rules">
                        <field name="approval_stage_rule_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="approval_status"/>
                                <field name="stage_id" domain="[('project_ids', '=', parent.id)]" options="{'no_create': True}"/>
                                <field name="task_state"/>
                                <field name="task_state_icon" widget="project_task_state_selection" readonly="1" nolabel="1" options="{'is_toggle_mode': false}"/>
                            </list>
                        </field>
                    </group>
                    <group string="Expiration / Timeout" colspan="2" invisible="not use_approval_requirements">
                        <group>
                            <field name="approval_expiration_days"/>
                            <field name="approval_expiration_action" invisible="not approval_expiration_days"/>
                        </group>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
